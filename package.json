{
  "name": "skeleton",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundaries": "turbo run boundaries",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "verify": "pnpm lint && turbo run typecheck boundaries test build",
    "check-env": "bash scripts/doctor.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
